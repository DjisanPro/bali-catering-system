# ===== BALI CATERING SERVICE — ENVIRONMENT CONFIG =====

# --- Server (REQUIRED for production hosting) ---
# Hosting providers (Railway, Render, Vercel) set PORT automatically
# Local dev: leave empty to use default 3000
PORT=3001
NODE_ENV=development

# --- Google AI (REQUIRED) ---
GEMINI_API_KEY=your_gemini_api_key_here
APP_URL=https://your-app-url.com

# --- Application Credentials (OPTIONAL - uses defaults) ---
# Override default PINs and salts for security in production
VITE_ADMIN_PIN=250420
VITE_ADMIN_SALT=your_admin_salt_here
VITE_SELLER1_SALT=your_seller1_salt_here
VITE_SELLER2_SALT=your_seller2_salt_here
