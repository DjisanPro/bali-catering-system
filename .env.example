# ===== BALI CATERING SERVICE — ENVIRONMENT CONFIG =====

# --- Server ---
# Hosting providers (Railway, Render, Vercel) set PORT automatically
# Local dev: leave empty to use default 3000
PORT=3000
NODE_ENV=development

# --- Application ---
# URL da aplicação (usada em ligações externas e no deploy)
APP_URL=http://localhost:3000

# --- Credenciais iniciais (apenas para primeira execução local) ---
# A password do administrador é definida no seed (server/database/seed.js)
# e deve ser alterada no primeiro login.

# --- Supabase (backend/PostgreSQL opt-in, para deploy futuro) ---
# SUPABASE_URL: URL do projeto PostgreSQL no Supabase (ex: https://xyzcompany.supabase.co)
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY: Chave secreta de serviço (guardar apenas no backend/env)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Firebase (opcional, para deploy no ecossistema Google) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=