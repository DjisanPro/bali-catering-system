import React, { useState, useEffect } from 'react';
import { useRestaurant } from '../../context/RestaurantContext';
import { SiteSettings, Banner, HomepageSection, ContactMessage } from '../../types';
import { MediaSelectorModal } from './MediaSelectorModal';
import {
  Globe,
  Image as ImageIcon,
  LayoutTemplate,
  MessageSquare,
  Save,
  Phone,
  Mail,
  MapPin,
  Clock,
  Instagram,
  Facebook,
  Share2,
  Plus,
  Trash2,
  CheckCircle2,
  Eye,
  ExternalLink,
  Calendar,
  Sparkles,
  Search,
  Sliders,
  FolderOpen,
  HelpCircle,
} from 'lucide-react';

export const CMSView: React.FC = () => {
  const {
    siteSettings,
    updateSiteSettings,
    homepageSections,
    updateHomepageSection,
    banners,
    createBanner,
    deleteBanner,
    contactMessages,
    updateContactMessageStatus,
    showToast,
  } = useRestaurant();

  const [activeTab, setActiveTab] = useState<
    'identity' | 'hero' | 'about_menu' | 'banners' | 'seo' | 'sections' | 'messages'
  >('identity');
  const [settingsForm, setSettingsForm] = useState<SiteSettings>({ ...siteSettings });

  // Sync settings when fetched or updated
  useEffect(() => {
    if (siteSettings) {
      setSettingsForm({ ...siteSettings });
    }
  }, [siteSettings]);

  // Media selector modal state
  const [isMediaModalOpen, setIsMediaModalOpen] = useState(false);
  const [mediaTargetField, setMediaTargetField] = useState<
    'logo' | 'hero' | 'about' | 'ogImage' | 'banner'
  >('hero');

  // Banner creation form state
  const [newBannerTitle, setNewBannerTitle] = useState('');
  const [newBannerSubtitle, setNewBannerSubtitle] = useState('');
  const [newBannerImageUrl, setNewBannerImageUrl] = useState(
    'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=1200&auto=format&fit=crop&q=85'
  );
  const [newBannerButtonText, setNewBannerButtonText] = useState('Ver Cardápio Especial');
  const [newBannerButtonLink, setNewBannerButtonLink] = useState('#menu');

  const handleOpenMediaFor = (field: 'logo' | 'hero' | 'about' | 'ogImage' | 'banner') => {
    setMediaTargetField(field);
    setIsMediaModalOpen(true);
  };

  const handleMediaSelected = (url: string) => {
    if (mediaTargetField === 'hero') {
      setSettingsForm((prev) => ({ ...prev, heroImageUrl: url }));
    } else if (mediaTargetField === 'about') {
      setSettingsForm((prev) => ({ ...prev, aboutImageUrl: url }));
    } else if (mediaTargetField === 'ogImage') {
      setSettingsForm((prev) => ({ ...prev, seoOgImageUrl: url }));
    } else if (mediaTargetField === 'logo') {
      setSettingsForm((prev) => ({ ...prev, logoUrl: url }));
    } else if (mediaTargetField === 'banner') {
      setNewBannerImageUrl(url);
    }
    setIsMediaModalOpen(false);
    showToast('Imagem Selecionada', 'Imagem vinculada ao campo com sucesso.');
  };

  const handleSaveSettings = (e: React.FormEvent) => {
    e.preventDefault();
    updateSiteSettings(settingsForm);
    showToast('Configurações Salvas', 'Identidade institucional e conteúdos atualizados com sucesso no Firestore.');
  };

  const handleAddBanner = (e: React.FormEvent) => {
    e.preventDefault();
    if (!newBannerTitle.trim()) return;

    createBanner({
      title: newBannerTitle.trim(),
      subtitle: newBannerSubtitle.trim() || undefined,
      imageUrl: newBannerImageUrl.trim(),
      buttonText: newBannerButtonText.trim() || undefined,
      buttonLink: newBannerButtonLink.trim() || undefined,
      isActive: true,
      displayOrder: banners.length + 1,
    });

    setNewBannerTitle('');
    setNewBannerSubtitle('');
    showToast('Banner Publicado', 'Novo banner adicionado ao carrossel da Área Pública.');
  };

  const unreadMessagesCount = contactMessages.filter((m) => m.status === 'UNREAD').length;

  return (
    <div className="space-y-6">
      {/* Header Section */}
      <div className="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div className="flex items-center gap-2">
            <span className="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-orange-100 text-[#F27D26]">
              Gestão de Conteúdos
            </span>
            <span className="text-xs text-slate-400">•</span>
            <span className="text-xs text-slate-500 font-medium">CMS Oficial Bali Catering Service</span>
          </div>
          <h2 className="text-xl font-heading font-extrabold text-slate-900 mt-1">
            Gestão de Conteúdo & Identidade (CMS)
          </h2>
          <p className="text-xs text-slate-500 mt-0.5">
            Configure informações da empresa, secção hero, cardápio, história, banners, SEO e consulte orçamentos de catering.
          </p>
        </div>

        {/* Tab Selector */}
        <div className="flex flex-wrap gap-1.5 p-1 bg-slate-100 rounded-xl border border-slate-200">
          <button
            type="button"
            onClick={() => setActiveTab('identity')}
            className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-colors cursor-pointer flex items-center gap-1.5 ${
              activeTab === 'identity'
                ? 'bg-white text-slate-900 shadow-xs'
                : 'text-slate-600 hover:text-slate-900'
            }`}
          >
            <Globe className="w-3.5 h-3.5 text-[#F27D26]" />
            <span>Identidade & Contactos</span>
          </button>

          <button
            type="button"
            onClick={() => setActiveTab('hero')}
            className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-colors cursor-pointer flex items-center gap-1.5 ${
              activeTab === 'hero'
                ? 'bg-white text-slate-900 shadow-xs'
                : 'text-slate-600 hover:text-slate-900'
            }`}
          >
            <Sparkles className="w-3.5 h-3.5 text-amber-500" />
            <span>Hero Principal</span>
          </button>

          <button
            type="button"
            onClick={() => setActiveTab('about_menu')}
            className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-colors cursor-pointer flex items-center gap-1.5 ${
              activeTab === 'about_menu'
                ? 'bg-white text-slate-900 shadow-xs'
                : 'text-slate-600 hover:text-slate-900'
            }`}
          >
            <Sliders className="w-3.5 h-3.5 text-indigo-600" />
            <span>História & Pratos</span>
          </button>

          <button
            type="button"
            onClick={() => setActiveTab('banners')}
            className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-colors cursor-pointer flex items-center gap-1.5 ${
              activeTab === 'banners'
                ? 'bg-white text-slate-900 shadow-xs'
                : 'text-slate-600 hover:text-slate-900'
            }`}
          >
            <ImageIcon className="w-3.5 h-3.5 text-blue-600" />
            <span>Banners ({banners.length})</span>
          </button>

          <button
            type="button"
            onClick={() => setActiveTab('seo')}
            className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-colors cursor-pointer flex items-center gap-1.5 ${
              activeTab === 'seo'
                ? 'bg-white text-slate-900 shadow-xs'
                : 'text-slate-600 hover:text-slate-900'
            }`}
          >
            <Search className="w-3.5 h-3.5 text-teal-600" />
            <span>SEO & Metatags</span>
          </button>

          <button
            type="button"
            onClick={() => setActiveTab('sections')}
            className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-colors cursor-pointer flex items-center gap-1.5 ${
              activeTab === 'sections'
                ? 'bg-white text-slate-900 shadow-xs'
                : 'text-slate-600 hover:text-slate-900'
            }`}
          >
            <LayoutTemplate className="w-3.5 h-3.5 text-emerald-600" />
            <span>Ordem das Secções</span>
          </button>

          <button
            type="button"
            onClick={() => setActiveTab('messages')}
            className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-colors cursor-pointer flex items-center gap-1.5 relative ${
              activeTab === 'messages'
                ? 'bg-white text-slate-900 shadow-xs'
                : 'text-slate-600 hover:text-slate-900'
            }`}
          >
            <MessageSquare className="w-3.5 h-3.5 text-amber-600" />
            <span>Mensagens ({contactMessages.length})</span>
            {unreadMessagesCount > 0 && (
              <span className="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
            )}
          </button>
        </div>
      </div>

      {/* Tab 1: Identity & Contacts Form */}
      {activeTab === 'identity' && (
        <form onSubmit={handleSaveSettings} className="space-y-6">
          <div className="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-5">
            <h3 className="text-sm font-heading font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2 border-b border-slate-100 pb-2">
              <Globe className="w-4 h-4 text-[#F27D26]" />
              <span>1. Identidade da Marca & Slogan</span>
            </h3>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
              <div>
                <label className="block text-slate-700 font-bold mb-1">Nome Comercial da Empresa *</label>
                <input
                  type="text"
                  required
                  value={settingsForm.companyName}
                  onChange={(e) => setSettingsForm({ ...settingsForm, companyName: e.target.value })}
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-semibold"
                />
              </div>

              <div>
                <label className="block text-slate-700 font-bold mb-1">Slogan Principal *</label>
                <input
                  type="text"
                  required
                  value={settingsForm.slogan}
                  onChange={(e) => setSettingsForm({ ...settingsForm, slogan: e.target.value })}
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-semibold"
                />
              </div>

              <div className="md:col-span-2">
                <label className="block text-slate-700 font-bold mb-1">Taxa Padrão de Entrega (Meticais)</label>
                <input
                  type="number"
                  min="0"
                  value={settingsForm.defaultDeliveryFee ?? 100}
                  onChange={(e) => setSettingsForm({ ...settingsForm, defaultDeliveryFee: Number(e.target.value) })}
                  className="w-full max-w-xs px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-bold text-emerald-700"
                />
              </div>
            </div>
          </div>

          <div className="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-5">
            <h3 className="text-sm font-heading font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2 border-b border-slate-100 pb-2">
              <Phone className="w-4 h-4 text-[#F27D26]" />
              <span>2. Contactos Operacionais & Localização em Tete</span>
            </h3>

            <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 text-xs">
              <div>
                <label className="block text-slate-700 font-bold mb-1">Número de WhatsApp Principal *</label>
                <input
                  type="text"
                  required
                  value={settingsForm.whatsappNumber}
                  onChange={(e) => setSettingsForm({ ...settingsForm, whatsappNumber: e.target.value })}
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-semibold text-emerald-700"
                />
              </div>

              <div>
                <label className="block text-slate-700 font-bold mb-1">Telefone Fixo / Linha Secundária</label>
                <input
                  type="text"
                  value={settingsForm.primaryPhone}
                  onChange={(e) => setSettingsForm({ ...settingsForm, primaryPhone: e.target.value })}
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-semibold"
                />
              </div>

              <div>
                <label className="block text-slate-700 font-bold mb-1">E-mail Comercial</label>
                <input
                  type="email"
                  value={settingsForm.email}
                  onChange={(e) => setSettingsForm({ ...settingsForm, email: e.target.value })}
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                />
              </div>

              <div className="sm:col-span-2">
                <label className="block text-slate-700 font-bold mb-1">Endereço Físico</label>
                <input
                  type="text"
                  value={settingsForm.address}
                  onChange={(e) => setSettingsForm({ ...settingsForm, address: e.target.value })}
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-medium"
                />
              </div>

              <div>
                <label className="block text-slate-700 font-bold mb-1">Cidade / Província</label>
                <input
                  type="text"
                  value={settingsForm.city}
                  onChange={(e) => setSettingsForm({ ...settingsForm, city: e.target.value })}
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-medium"
                />
              </div>

              <div className="sm:col-span-3">
                <label className="block text-slate-700 font-bold mb-1">Horário de Funcionamento</label>
                <input
                  type="text"
                  value={settingsForm.businessHours}
                  onChange={(e) => setSettingsForm({ ...settingsForm, businessHours: e.target.value })}
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-medium text-slate-800"
                />
              </div>
            </div>
          </div>

          <div className="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-5">
            <h3 className="text-sm font-heading font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2 border-b border-slate-100 pb-2">
              <Share2 className="w-4 h-4 text-[#F27D26]" />
              <span>3. Redes Sociais & Rodapé</span>
            </h3>

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
              <div>
                <label className="block text-slate-700 font-bold mb-1">Link do Instagram</label>
                <input
                  type="text"
                  value={settingsForm.instagramUrl || ''}
                  onChange={(e) => setSettingsForm({ ...settingsForm, instagramUrl: e.target.value })}
                  placeholder="https://instagram.com/balicateringservice"
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                />
              </div>

              <div>
                <label className="block text-slate-700 font-bold mb-1">Link do Facebook</label>
                <input
                  type="text"
                  value={settingsForm.facebookUrl || ''}
                  onChange={(e) => setSettingsForm({ ...settingsForm, facebookUrl: e.target.value })}
                  placeholder="https://facebook.com/balicateringservice"
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                />
              </div>

              <div className="sm:col-span-2">
                <label className="block text-slate-700 font-bold mb-1">Texto de Direitos Autorais / Rodapé</label>
                <input
                  type="text"
                  value={settingsForm.footerText || ''}
                  onChange={(e) => setSettingsForm({ ...settingsForm, footerText: e.target.value })}
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none text-slate-600"
                />
              </div>
            </div>
          </div>

          <div className="flex justify-end">
            <button
              type="submit"
              className="px-6 py-2.5 rounded-xl bg-[#F27D26] hover:bg-[#d96818] text-white font-bold text-xs shadow-md transition-all flex items-center gap-2 cursor-pointer"
            >
              <Save className="w-4 h-4" />
              <span>Guardar Alterações</span>
            </button>
          </div>
        </form>
      )}

      {/* Tab 2: Hero Section */}
      {activeTab === 'hero' && (
        <form onSubmit={handleSaveSettings} className="space-y-6">
          <div className="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-5">
            <div className="flex items-center justify-between border-b border-slate-100 pb-2">
              <h3 className="text-sm font-heading font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                <Sparkles className="w-4 h-4 text-[#F27D26]" />
                <span>Apresentação Principal da Página (Hero Section)</span>
              </h3>
              <span className="text-[11px] text-slate-500 font-medium">Impacto imediato para o cliente</span>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
              <div>
                <label className="block text-slate-700 font-bold mb-1">Título Principal do Hero *</label>
                <input
                  type="text"
                  required
                  value={settingsForm.heroTitle || ''}
                  onChange={(e) => setSettingsForm({ ...settingsForm, heroTitle: e.target.value })}
                  placeholder="Ex: Sabor que faz voltar."
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-semibold text-sm"
                />
                <p className="text-[10px] text-slate-400 mt-1">A primeira e a última palavra recebem destaque visual na tipografia editorial.</p>
              </div>

              <div>
                <label className="block text-slate-700 font-bold mb-1">Texto do Botão de Ação (CTA)</label>
                <input
                  type="text"
                  value={settingsForm.heroButtonText || ''}
                  onChange={(e) => setSettingsForm({ ...settingsForm, heroButtonText: e.target.value })}
                  placeholder="Ver Menu"
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-semibold"
                />
              </div>

              <div className="md:col-span-2">
                <label className="block text-slate-700 font-bold mb-1">Subtítulo / Descrição de Impacto</label>
                <textarea
                  rows={3}
                  value={settingsForm.heroSubtitle || ''}
                  onChange={(e) => setSettingsForm({ ...settingsForm, heroSubtitle: e.target.value })}
                  placeholder="Grelhados no carvão, hambúrgueres artesanais, sandes de carne assada e doces regionais de Malambe..."
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none leading-relaxed"
                />
              </div>

              <div className="md:col-span-2">
                <label className="block text-slate-700 font-bold mb-1">Imagem Principal do Hero (Alta Qualidade)</label>
                <div className="flex gap-2">
                  <input
                    type="text"
                    value={settingsForm.heroImageUrl || ''}
                    onChange={(e) => setSettingsForm({ ...settingsForm, heroImageUrl: e.target.value })}
                    placeholder="https://..."
                    className="flex-1 px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                  />
                  <button
                    type="button"
                    onClick={() => handleOpenMediaFor('hero')}
                    className="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center gap-1.5 transition-colors cursor-pointer"
                  >
                    <FolderOpen className="w-3.5 h-3.5 text-blue-600" />
                    <span>Biblioteca de Mídia</span>
                  </button>
                </div>
              </div>
            </div>

            {/* Live Preview Card */}
            <div className="pt-2">
              <label className="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">
                Pré-visualização do Hero
              </label>
              <div className="p-6 rounded-2xl bg-[#FAF8F5] border border-orange-200/50 flex flex-col md:flex-row items-center gap-6">
                <div className="flex-1 space-y-3">
                  <span className="text-[10px] font-bold uppercase tracking-widest text-[#E86319] bg-orange-100/70 px-2.5 py-0.5 rounded-full">
                    {settingsForm.companyName} • {settingsForm.city}
                  </span>
                  <h4 className="text-2xl font-serif font-black text-zinc-950">
                    {settingsForm.heroTitle || 'Sabor que faz voltar.'}
                  </h4>
                  <p className="text-xs text-zinc-600 leading-relaxed max-w-md">
                    {settingsForm.heroSubtitle || 'Apresentação refinada dos pratos e serviços Bali Catering em Tete.'}
                  </p>
                  <button
                    type="button"
                    className="px-4 py-2 rounded-full bg-[#E86319] text-white font-bold text-xs shadow-xs"
                  >
                    {settingsForm.heroButtonText || 'Ver Menu'}
                  </button>
                </div>

                <div className="w-full md:w-48 h-32 rounded-xl overflow-hidden bg-slate-800 shadow-md shrink-0">
                  <img
                    src={settingsForm.heroImageUrl || "https://images.unsplash.com/photo-1598515214211-89d3c73ae83b?w=600&auto=format&fit=crop&q=80"}
                    alt="Hero Preview"
                    className="w-full h-full object-cover"
                    referrerPolicy="no-referrer"
                  />
                </div>
              </div>
            </div>
          </div>

          <div className="flex justify-end">
            <button
              type="submit"
              className="px-6 py-2.5 rounded-xl bg-[#F27D26] hover:bg-[#d96818] text-white font-bold text-xs shadow-md transition-all flex items-center gap-2 cursor-pointer"
            >
              <Save className="w-4 h-4" />
              <span>Salvar Seção Hero</span>
            </button>
          </div>
        </form>
      )}

      {/* Tab 3: Story & Menu Sections */}
      {activeTab === 'about_menu' && (
        <form onSubmit={handleSaveSettings} className="space-y-6">
          {/* Menu Section Config */}
          <div className="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-5">
            <h3 className="text-sm font-heading font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2 border-b border-slate-100 pb-2">
              <Sliders className="w-4 h-4 text-[#F27D26]" />
              <span>1. Seção de Cardápio & Pratos</span>
            </h3>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
              <div>
                <label className="block text-slate-700 font-bold mb-1">Título da Seção de Cardápio</label>
                <input
                  type="text"
                  value={settingsForm.menuSectionTitle || ''}
                  onChange={(e) => setSettingsForm({ ...settingsForm, menuSectionTitle: e.target.value })}
                  placeholder="Escolha os seus pratos."
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-semibold"
                />
              </div>

              <div>
                <label className="block text-slate-700 font-bold mb-1">Subtítulo da Seção de Cardápio</label>
                <input
                  type="text"
                  value={settingsForm.menuSectionDescription || ''}
                  onChange={(e) => setSettingsForm({ ...settingsForm, menuSectionDescription: e.target.value })}
                  placeholder="Feitos na hora com carnes selecionadas, pão fresco e temperos autênticos..."
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                />
              </div>
            </div>
          </div>

          {/* About / Story Section Config */}
          <div className="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-5">
            <h3 className="text-sm font-heading font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2 border-b border-slate-100 pb-2">
              <Globe className="w-4 h-4 text-[#F27D26]" />
              <span>2. Nossa Proposta & História Culinária</span>
            </h3>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
              <div className="md:col-span-2">
                <label className="block text-slate-700 font-bold mb-1">Título Editorial da Proposta</label>
                <input
                  type="text"
                  value={settingsForm.aboutTitle || ''}
                  onChange={(e) => setSettingsForm({ ...settingsForm, aboutTitle: e.target.value })}
                  placeholder="Culinária feita com rigor, brasa e carinho."
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-semibold text-sm"
                />
              </div>

              <div className="md:col-span-2">
                <label className="block text-slate-700 font-bold mb-1">Texto Descritivo Institucional</label>
                <textarea
                  rows={4}
                  value={settingsForm.aboutDescription || settingsForm.aboutUs || ''}
                  onChange={(e) =>
                    setSettingsForm({
                      ...settingsForm,
                      aboutDescription: e.target.value,
                      aboutUs: e.target.value,
                    })
                  }
                  placeholder="O Bali Catering Service nasceu com uma missão clara: servir comida saborosa..."
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none leading-relaxed"
                />
              </div>

              <div className="md:col-span-2">
                <label className="block text-slate-700 font-bold mb-1">Foto Ilustrativa da Proposta (Sobre Nós)</label>
                <div className="flex gap-2">
                  <input
                    type="text"
                    value={settingsForm.aboutImageUrl || ''}
                    onChange={(e) => setSettingsForm({ ...settingsForm, aboutImageUrl: e.target.value })}
                    placeholder="https://..."
                    className="flex-1 px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                  />
                  <button
                    type="button"
                    onClick={() => handleOpenMediaFor('about')}
                    className="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center gap-1.5 transition-colors cursor-pointer"
                  >
                    <FolderOpen className="w-3.5 h-3.5 text-blue-600" />
                    <span>Biblioteca de Mídia</span>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div className="flex justify-end">
            <button
              type="submit"
              className="px-6 py-2.5 rounded-xl bg-[#F27D26] hover:bg-[#d96818] text-white font-bold text-xs shadow-md transition-all flex items-center gap-2 cursor-pointer"
            >
              <Save className="w-4 h-4" />
              <span>Salvar Cardápio & História</span>
            </button>
          </div>
        </form>
      )}

      {/* Tab 4: Banners & Carousel Management */}
      {activeTab === 'banners' && (
        <div className="space-y-6">
          {/* Create Banner Card */}
          <div className="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs">
            <h3 className="text-sm font-heading font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2 border-b border-slate-100 pb-2 mb-4">
              <Plus className="w-4 h-4 text-[#F27D26]" />
              <span>Criar Novo Banner Promocional</span>
            </h3>

            <form onSubmit={handleAddBanner} className="space-y-4 text-xs">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label className="block text-slate-700 font-bold mb-1">Título do Banner *</label>
                  <input
                    type="text"
                    required
                    value={newBannerTitle}
                    onChange={(e) => setNewBannerTitle(e.target.value)}
                    placeholder="Ex: Frango Assado à Bali com Fritas Crocantes"
                    className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-semibold"
                  />
                </div>

                <div>
                  <label className="block text-slate-700 font-bold mb-1">Subtítulo / Chamada</label>
                  <input
                    type="text"
                    value={newBannerSubtitle}
                    onChange={(e) => setNewBannerSubtitle(e.target.value)}
                    placeholder="Ex: Sabor inconfundível grelhado no carvão vegetal de Moatize"
                    className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                  />
                </div>

                <div className="sm:col-span-2">
                  <label className="block text-slate-700 font-bold mb-1">URL da Imagem de Fundo (Alta Resolução)</label>
                  <div className="flex gap-2">
                    <input
                      type="text"
                      required
                      value={newBannerImageUrl}
                      onChange={(e) => setNewBannerImageUrl(e.target.value)}
                      className="flex-1 px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                    />
                    <button
                      type="button"
                      onClick={() => handleOpenMediaFor('banner')}
                      className="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center gap-1.5 transition-colors cursor-pointer"
                    >
                      <FolderOpen className="w-3.5 h-3.5 text-blue-600" />
                      <span>Biblioteca</span>
                    </button>
                  </div>
                </div>

                <div>
                  <label className="block text-slate-700 font-bold mb-1">Texto do Botão</label>
                  <input
                    type="text"
                    value={newBannerButtonText}
                    onChange={(e) => setNewBannerButtonText(e.target.value)}
                    className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                  />
                </div>

                <div>
                  <label className="block text-slate-700 font-bold mb-1">Link de Destino do Botão</label>
                  <input
                    type="text"
                    value={newBannerButtonLink}
                    onChange={(e) => setNewBannerButtonLink(e.target.value)}
                    className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                  />
                </div>
              </div>

              <div className="flex justify-end">
                <button
                  type="submit"
                  className="px-5 py-2 bg-slate-900 hover:bg-black text-white font-bold rounded-xl transition-all flex items-center gap-1.5 cursor-pointer shadow-xs"
                >
                  <Plus className="w-3.5 h-3.5 text-orange-400" />
                  <span>Publicar Banner</span>
                </button>
              </div>
            </form>
          </div>

          {/* List of Active Banners */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {banners.map((b) => (
              <div
                key={b.id}
                className="bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-xs flex flex-col justify-between"
              >
                <div className="relative h-40 bg-slate-900">
                  <img
                    src={b.imageUrl}
                    alt={b.title}
                    className="w-full h-full object-cover opacity-80"
                    referrerPolicy="no-referrer"
                  />
                  <div className="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent p-4 flex flex-col justify-end">
                    <h4 className="text-white font-heading font-extrabold text-sm">{b.title}</h4>
                    {b.subtitle && <p className="text-slate-300 text-[11px] mt-0.5 line-clamp-1">{b.subtitle}</p>}
                  </div>
                </div>

                <div className="p-3 bg-slate-50 flex items-center justify-between border-t border-slate-100">
                  <div className="flex items-center gap-2 text-[11px] text-slate-600 font-medium">
                    <span className="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span>Ativo na Página Inicial</span>
                  </div>

                  <button
                    type="button"
                    onClick={() => deleteBanner(b.id)}
                    className="p-1.5 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors cursor-pointer"
                    title="Excluir Banner"
                  >
                    <Trash2 className="w-4 h-4" />
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Tab 5: SEO & OpenGraph Social Sharing */}
      {activeTab === 'seo' && (
        <form onSubmit={handleSaveSettings} className="space-y-6">
          <div className="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-5">
            <h3 className="text-sm font-heading font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2 border-b border-slate-100 pb-2">
              <Search className="w-4 h-4 text-[#F27D26]" />
              <span>Otimização para Mecanismos de Busca (SEO Google)</span>
            </h3>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
              <div>
                <label className="block text-slate-700 font-bold mb-1">Título SEO da Página (Tag &lt;title&gt;)</label>
                <input
                  type="text"
                  value={settingsForm.seoTitle || ''}
                  onChange={(e) => setSettingsForm({ ...settingsForm, seoTitle: e.target.value })}
                  placeholder="Bali Catering Service | O Melhor Sabor de Tete"
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-semibold"
                />
              </div>

              <div>
                <label className="block text-slate-700 font-bold mb-1">Palavras-chave (Keywords separadas por vírgulas)</label>
                <input
                  type="text"
                  value={settingsForm.seoKeywords || ''}
                  onChange={(e) => setSettingsForm({ ...settingsForm, seoKeywords: e.target.value })}
                  placeholder="catering tete, comida take away, grelhados no carvão, hambúrguer artesanal"
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                />
              </div>

              <div className="md:col-span-2">
                <label className="block text-slate-700 font-bold mb-1">Meta Descrição (Resumo exibido no Google)</label>
                <textarea
                  rows={2}
                  value={settingsForm.seoMetaDescription || ''}
                  onChange={(e) => setSettingsForm({ ...settingsForm, seoMetaDescription: e.target.value })}
                  placeholder="Bali Catering Service em Tete. Grelhados no carvão, hambúrgueres artesanais, sandes de carne assada..."
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none leading-relaxed"
                />
              </div>
            </div>

            {/* Google Snippet Simulation */}
            <div className="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
              <span className="text-[10px] uppercase font-bold text-slate-400">Prévia no Google Search</span>
              <div className="text-blue-700 font-medium text-sm hover:underline cursor-pointer">
                {settingsForm.seoTitle || `${settingsForm.companyName} | Gastronomia em ${settingsForm.city}`}
              </div>
              <div className="text-[11px] text-emerald-800">
                https://balicatering.co.mz/
              </div>
              <div className="text-xs text-slate-600 line-clamp-2">
                {settingsForm.seoMetaDescription || settingsForm.slogan}
              </div>
            </div>
          </div>

          <div className="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-5">
            <h3 className="text-sm font-heading font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2 border-b border-slate-100 pb-2">
              <Share2 className="w-4 h-4 text-blue-600" />
              <span>Compartilhamento Social (WhatsApp, Facebook & LinkedIn)</span>
            </h3>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
              <div>
                <label className="block text-slate-700 font-bold mb-1">Título de Compartilhamento (og:title)</label>
                <input
                  type="text"
                  value={settingsForm.seoOgTitle || ''}
                  onChange={(e) => setSettingsForm({ ...settingsForm, seoOgTitle: e.target.value })}
                  placeholder="Bali Catering Service - Encomende Online em Tete"
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-semibold"
                />
              </div>

              <div>
                <label className="block text-slate-700 font-bold mb-1">Descrição Social (og:description)</label>
                <input
                  type="text"
                  value={settingsForm.seoOgDescription || ''}
                  onChange={(e) => setSettingsForm({ ...settingsForm, seoOgDescription: e.target.value })}
                  placeholder="Cardápio selecionado com entrega rápida e catering para eventos."
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                />
              </div>

              <div className="md:col-span-2">
                <label className="block text-slate-700 font-bold mb-1">Imagem de Compartilhamento Social (og:image)</label>
                <div className="flex gap-2">
                  <input
                    type="text"
                    value={settingsForm.seoOgImageUrl || ''}
                    onChange={(e) => setSettingsForm({ ...settingsForm, seoOgImageUrl: e.target.value })}
                    placeholder="https://..."
                    className="flex-1 px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                  />
                  <button
                    type="button"
                    onClick={() => handleOpenMediaFor('ogImage')}
                    className="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center gap-1.5 transition-colors cursor-pointer"
                  >
                    <FolderOpen className="w-3.5 h-3.5 text-blue-600" />
                    <span>Biblioteca</span>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div className="flex justify-end">
            <button
              type="submit"
              className="px-6 py-2.5 rounded-xl bg-[#F27D26] hover:bg-[#d96818] text-white font-bold text-xs shadow-md transition-all flex items-center gap-2 cursor-pointer"
            >
              <Save className="w-4 h-4" />
              <span>Salvar Metatags & SEO</span>
            </button>
          </div>
        </form>
      )}

      {/* Tab 6: Homepage Sections Content */}
      {activeTab === 'sections' && (
        <div className="space-y-4">
          {homepageSections.map((sec) => (
            <div key={sec.id} className="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs space-y-3">
              <div className="flex items-center justify-between border-b border-slate-100 pb-2">
                <div>
                  <span className="text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                    Secção: {sec.key}
                  </span>
                  <h4 className="text-sm font-heading font-bold text-slate-900">{sec.title}</h4>
                </div>
                <span className="text-xs px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 font-semibold">
                  Ordem: {sec.displayOrder}
                </span>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <div>
                  <label className="block text-slate-700 font-bold mb-1">Título Exibido</label>
                  <input
                    type="text"
                    value={sec.title}
                    onChange={(e) => updateHomepageSection(sec.id, { title: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-semibold"
                  />
                </div>

                <div>
                  <label className="block text-slate-700 font-bold mb-1">Subtítulo / Descrição</label>
                  <input
                    type="text"
                    value={sec.subtitle || ''}
                    onChange={(e) => updateHomepageSection(sec.id, { subtitle: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                  />
                </div>
              </div>
            </div>
          ))}
        </div>
      )}

      {/* Tab 7: Contact & Catering Messages */}
      {activeTab === 'messages' && (
        <div className="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-4">
          <div className="flex items-center justify-between border-b border-slate-100 pb-3">
            <div>
              <h3 className="text-sm font-heading font-bold text-slate-900">
                Mensagens & Pedidos de Orçamento de Catering
              </h3>
              <p className="text-xs text-slate-500">
                Solicitações enviadas pelos clientes diretamente na Área Pública para eventos e encomendas.
              </p>
            </div>
            <span className="px-2.5 py-1 rounded-full text-xs font-bold bg-orange-100 text-[#F27D26]">
              {contactMessages.length} mensagem(ns) registrada(s)
            </span>
          </div>

          {contactMessages.length === 0 ? (
            <div className="text-center py-12 text-slate-400 text-xs">
              <MessageSquare className="w-8 h-8 mx-auto text-slate-300 mb-2" />
              <p>Nenhuma mensagem recebida até o momento.</p>
            </div>
          ) : (
            <div className="divide-y divide-slate-100">
              {contactMessages.map((msg) => (
                <div key={msg.id} className="py-4 space-y-2">
                  <div className="flex flex-wrap items-center justify-between gap-2">
                    <div className="flex items-center gap-2">
                      <span className="font-bold text-xs text-slate-900">{msg.name}</span>
                      <span className="text-[11px] text-slate-500">({msg.phone})</span>
                      {msg.email && <span className="text-[11px] text-slate-400">• {msg.email}</span>}
                    </div>

                    <div className="flex items-center gap-2">
                      <span className="text-[10px] text-slate-400">
                        {new Date(msg.createdAt).toLocaleDateString('pt-MZ')} às{' '}
                        {new Date(msg.createdAt).toLocaleTimeString('pt-MZ', {
                          hour: '2-digit',
                          minute: '2-digit',
                        })}
                      </span>

                      <select
                        value={msg.status}
                        onChange={(e) => updateContactMessageStatus(msg.id, e.target.value as any)}
                        className={`text-[11px] font-bold px-2 py-1 rounded-md border cursor-pointer ${
                          msg.status === 'UNREAD'
                            ? 'bg-amber-50 text-amber-700 border-amber-200'
                            : msg.status === 'REPLIED'
                            ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
                            : 'bg-slate-50 text-slate-700 border-slate-200'
                        }`}
                      >
                        <option value="UNREAD">Não Lida</option>
                        <option value="READ">Em Análise</option>
                        <option value="REPLIED">Respondida</option>
                        <option value="ARCHIVED">Arquivada</option>
                      </select>
                    </div>
                  </div>

                  {msg.eventDate && (
                    <div className="flex items-center gap-2 text-[11px] text-amber-700 bg-amber-50/60 px-2.5 py-1 rounded-lg border border-amber-200/60 w-fit">
                      <Calendar className="w-3.5 h-3.5" />
                      <span>
                        Data do Evento Prevista: <strong>{msg.eventDate}</strong>
                      </span>
                      {msg.guestCount && <span>• Convidados: <strong>{msg.guestCount} pessoas</strong></span>}
                    </div>
                  )}

                  <div className="p-3 bg-slate-50 rounded-xl text-xs text-slate-700 leading-relaxed border border-slate-100">
                    {msg.message}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      )}

      {/* Modal Seletor de Imagens da Biblioteca */}
      <MediaSelectorModal
        isOpen={isMediaModalOpen}
        onClose={() => setIsMediaModalOpen(false)}
        onSelect={handleMediaSelected}
        title={
          mediaTargetField === 'hero'
            ? 'Escolher Foto para o Hero Principal'
            : mediaTargetField === 'about'
            ? 'Escolher Foto para a Proposta / História'
            : mediaTargetField === 'banner'
            ? 'Escolher Foto para o Banner Promocional'
            : 'Escolher Imagem'
        }
      />
    </div>
  );
};

      {/* Tab 2: Banners & Carousel Management */}
      {activeTab === 'banners' && (
        <div className="space-y-6">
          {/* Create Banner Card */}
          <div className="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs">
            <h3 className="text-sm font-heading font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2 border-b border-slate-100 pb-2 mb-4">
              <Plus className="w-4 h-4 text-[#F27D26]" />
              <span>Criar Novo Banner Promocional</span>
            </h3>

            <form onSubmit={handleAddBanner} className="space-y-4 text-xs">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label className="block text-slate-700 font-bold mb-1">Título do Banner *</label>
                  <input
                    type="text"
                    required
                    value={newBannerTitle}
                    onChange={(e) => setNewBannerTitle(e.target.value)}
                    placeholder="Ex: Frango Assado à Bali com Fritas Crocantes"
                    className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-semibold"
                  />
                </div>

                <div>
                  <label className="block text-slate-700 font-bold mb-1">Subtítulo / Chamada</label>
                  <input
                    type="text"
                    value={newBannerSubtitle}
                    onChange={(e) => setNewBannerSubtitle(e.target.value)}
                    placeholder="Ex: Sabor inconfundível grelhado no carvão vegetal de Moatize"
                    className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                  />
                </div>

                <div className="sm:col-span-2">
                  <label className="block text-slate-700 font-bold mb-1">URL da Imagem de Fundo (Alta Resolução)</label>
                  <input
                    type="text"
                    required
                    value={newBannerImageUrl}
                    onChange={(e) => setNewBannerImageUrl(e.target.value)}
                    className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                  />
                </div>

                <div>
                  <label className="block text-slate-700 font-bold mb-1">Texto do Botão</label>
                  <input
                    type="text"
                    value={newBannerButtonText}
                    onChange={(e) => setNewBannerButtonText(e.target.value)}
                    className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                  />
                </div>

                <div>
                  <label className="block text-slate-700 font-bold mb-1">Link de Destino do Botão</label>
                  <input
                    type="text"
                    value={newBannerButtonLink}
                    onChange={(e) => setNewBannerButtonLink(e.target.value)}
                    className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                  />
                </div>
              </div>

              <div className="flex justify-end">
                <button
                  type="submit"
                  className="px-5 py-2 bg-slate-900 hover:bg-black text-white font-bold rounded-xl transition-all flex items-center gap-1.5 cursor-pointer shadow-xs"
                >
                  <Plus className="w-3.5 h-3.5 text-orange-400" />
                  <span>Publicar Banner</span>
                </button>
              </div>
            </form>
          </div>

          {/* List of Active Banners */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {banners.map((b) => (
              <div
                key={b.id}
                className="bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-xs flex flex-col justify-between"
              >
                <div className="relative h-40 bg-slate-900">
                  <img
                    src={b.imageUrl}
                    alt={b.title}
                    className="w-full h-full object-cover opacity-80"
                    referrerPolicy="no-referrer"
                  />
                  <div className="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent p-4 flex flex-col justify-end">
                    <h4 className="text-white font-heading font-extrabold text-sm">{b.title}</h4>
                    {b.subtitle && <p className="text-slate-300 text-[11px] mt-0.5 line-clamp-1">{b.subtitle}</p>}
                  </div>
                </div>

                <div className="p-3 bg-slate-50 flex items-center justify-between border-t border-slate-100">
                  <div className="flex items-center gap-2 text-[11px] text-slate-600 font-medium">
                    <span className="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span>Ativo na Página Inicial</span>
                  </div>

                  <button
                    type="button"
                    onClick={() => deleteBanner(b.id)}
                    className="p-1.5 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors cursor-pointer"
                    title="Excluir Banner"
                  >
                    <Trash2 className="w-4 h-4" />
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Tab 3: Homepage Sections Content */}
      {activeTab === 'sections' && (
        <div className="space-y-4">
          {homepageSections.map((sec) => (
            <div key={sec.id} className="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs space-y-3">
              <div className="flex items-center justify-between border-b border-slate-100 pb-2">
                <div>
                  <span className="text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                    Secção: {sec.key}
                  </span>
                  <h4 className="text-sm font-heading font-bold text-slate-900">{sec.title}</h4>
                </div>
                <span className="text-xs px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 font-semibold">
                  Ordem: {sec.displayOrder}
                </span>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <div>
                  <label className="block text-slate-700 font-bold mb-1">Título Exibido</label>
                  <input
                    type="text"
                    value={sec.title}
                    onChange={(e) => updateHomepageSection(sec.id, { title: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none font-semibold"
                  />
                </div>

                <div>
                  <label className="block text-slate-700 font-bold mb-1">Subtítulo / Descrição</label>
                  <input
                    type="text"
                    value={sec.subtitle || ''}
                    onChange={(e) => updateHomepageSection(sec.id, { subtitle: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:outline-none"
                  />
                </div>
              </div>
            </div>
          ))}
        </div>
      )}

      {/* Tab 4: Contact & Catering Messages */}
      {activeTab === 'messages' && (
        <div className="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-4">
          <div className="flex items-center justify-between border-b border-slate-100 pb-3">
            <div>
              <h3 className="text-sm font-heading font-bold text-slate-900">
                Mensagens & Pedidos de Orçamento de Catering
              </h3>
              <p className="text-xs text-slate-500">
                Solicitações enviadas pelos clientes diretamente na Área Pública para eventos e encomendas.
              </p>
            </div>
            <span className="px-2.5 py-1 rounded-full text-xs font-bold bg-orange-100 text-[#F27D26]">
              {contactMessages.length} mensagem(ns) registrada(s)
            </span>
          </div>

          {contactMessages.length === 0 ? (
            <div className="text-center py-12 text-slate-400 text-xs">
              <MessageSquare className="w-8 h-8 mx-auto text-slate-300 mb-2" />
              <p>Nenhuma mensagem recebida até o momento.</p>
            </div>
          ) : (
            <div className="divide-y divide-slate-100">
              {contactMessages.map((msg) => (
                <div key={msg.id} className="py-4 space-y-2">
                  <div className="flex flex-wrap items-center justify-between gap-2">
                    <div className="flex items-center gap-2">
                      <span className="font-bold text-xs text-slate-900">{msg.name}</span>
                      <span className="text-[11px] text-slate-500">({msg.phone})</span>
                      {msg.email && <span className="text-[11px] text-slate-400">• {msg.email}</span>}
                    </div>

                    <div className="flex items-center gap-2">
                      <span className="text-[10px] text-slate-400">
                        {new Date(msg.createdAt).toLocaleDateString('pt-MZ')} às {new Date(msg.createdAt).toLocaleTimeString('pt-MZ', { hour: '2-digit', minute: '2-digit' })}
                      </span>

                      <select
                        value={msg.status}
                        onChange={(e) => updateContactMessageStatus(msg.id, e.target.value as any)}
                        className={`text-[11px] font-bold px-2 py-1 rounded-md border cursor-pointer ${
                          msg.status === 'UNREAD'
                            ? 'bg-amber-50 text-amber-700 border-amber-200'
                            : msg.status === 'REPLIED'
                            ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
                            : 'bg-slate-50 text-slate-700 border-slate-200'
                        }`}
                      >
                        <option value="UNREAD">Não Lida</option>
                        <option value="READ">Em Análise</option>
                        <option value="REPLIED">Respondida</option>
                        <option value="ARCHIVED">Arquivada</option>
                      </select>
                    </div>
                  </div>

                  {msg.eventDate && (
                    <div className="flex items-center gap-2 text-[11px] text-amber-700 bg-amber-50/60 px-2.5 py-1 rounded-lg border border-amber-200/60 w-fit">
                      <Calendar className="w-3.5 h-3.5" />
                      <span>Data do Evento Prevista: <strong>{msg.eventDate}</strong></span>
                      {msg.guestCount && <span>• Convidados: <strong>{msg.guestCount} pessoas</strong></span>}
                    </div>
                  )}

                  <div className="p-3 bg-slate-50 rounded-xl text-xs text-slate-700 leading-relaxed border border-slate-100">
                    {msg.message}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      )}
